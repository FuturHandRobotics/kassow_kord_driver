<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="kassow_kord_ros2_control"
              params="name
                      prefix
                      use_mock_hardware:=true
                      ip_address:=10.23.23.238
                      port:=28283
                      session_id:=1
                      waitSync_timeout_ms:=8
                      scheduling_policy:=detached
                      is_async:=true
                      rw_rate:=250
                      thread_priority:=80
                      load1_mass:=''
                      load1_cog:=''
                      load1_inertia:=''"
                      >

    <!-- is_async=false runs read()/write() in the controller manager's own RT
         thread, paced by KORD waitSync; true moves them to a separate thread. -->
    <ros2_control name="${name}" type="system" is_async="${str(is_async).lower()}" rw_rate="${rw_rate}">
      <properties>
        <!-- This thread does the KORD read/write, i.e. the one command per 4 ms
             tick the controller counts. At 30 it sat below the controller
             manager's own 50 and lost scheduling contests, and every missed
             cycle is a command the CBun counts as lost. Kassow's real-time
             loop guidance recommends RT priority 80 for the control loop
             (their benchmark client runs at 99, pinned). -->
        <async scheduling_policy="${scheduling_policy}" print_warnings="true" thread_priority="${thread_priority}"/>
      </properties>
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>kassow_kord_hardware_interface/KassowKordHardwareInterface</plugin>
          <param name="ip_address">${ip_address}</param>
          <param name="port">${port}</param>
          <param name="session_id">${session_id}</param>
          <param name="waitSync_timeout_ms">${waitSync_timeout_ms}</param>
          <!-- End-of-arm tool load (KORD LOAD1), sent on activation; empty = leave the
               controller's own LOAD1. CoG / inertia: comma-separated, tool flange frame. -->
          <xacro:if value="${str(load1_mass) != ''}">
            <param name="load1_mass">${load1_mass}</param>
            <param name="load1_cog">${load1_cog}</param>
            <param name="load1_inertia">${load1_inertia}</param>
          </xacro:if>
        </xacro:unless>
      </hardware>

      <joint name="${prefix}_joint_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}_joint_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}_joint_3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}_joint_4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}_joint_5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}_joint_6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}_joint_7">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
